# keystore.properties — TEMPLATE ONLY
#
# DO NOT commit a file named "keystore.properties" to version control.
# That filename is already in .gitignore so your passwords are safe.
#
# Steps:
#   1. Generate a keystore if you don't have one yet:
#        keytool -genkeypair -v \
#          -keystore app/release.jks \
#          -keyalg RSA -keysize 2048 -validity 10000 \
#          -alias release-key
#
#   2. Copy this file to "keystore.properties" (no ".template" extension).
#
#   3. Fill in the four values below with your own information.
#
#   4. Keep "keystore.properties" and your .jks file out of version control.
#      Both patterns are already listed in .gitignore.

# Path to the keystore file, relative to the project root.
storeFile=app/release.jks

# Password you chose when you ran keytool (the "keystore password").
storePassword=YOUR_KEYSTORE_PASSWORD

# Alias you chose when you ran keytool (the "key alias").
keyAlias=release-key

# Password for the key itself (the "key password").
keyPassword=YOUR_KEY_PASSWORD
