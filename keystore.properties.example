# Copy this file to keystore.properties and fill in your actual values.
# IMPORTANT: Never commit keystore.properties to version control.

# Path to your keystore file (relative to the project root)
storeFile=../release.jks

# Keystore password
storePassword=your_keystore_password

# Key alias (the alias you used when generating the key)
keyAlias=release

# Key password
keyPassword=your_key_password
