# Copy this file to keystore.properties and fill in your actual values.
# DO NOT commit keystore.properties to version control.
#
# storeFile: path to your keystore file (relative to app/ directory or absolute path)
# storePassword: the password for your keystore
# keyAlias: the alias of the key in your keystore
# keyPassword: the password for your key
storeFile=../release-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
