# Keystore configuration for signing release builds.
#
# INSTRUCTIONS:
# 1. Copy this file to keystore.properties (in the root project directory).
# 2. Fill in the values below with your actual keystore information.
# 3. NEVER commit keystore.properties to version control.
#    It is already listed in .gitignore.
#
# To generate a new keystore, run:
#   keytool -genkey -v -keystore release.keystore -alias <your_alias> \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Or use Android Studio:
#   Build > Generate Signed Bundle / APK > Create new...

# Path to the keystore file (relative to the app/ directory, or absolute path)
storeFile=../release.keystore

# Password for the keystore
storePassword=your_keystore_password

# Alias name used when the keystore was created
keyAlias=your_key_alias

# Password for the key alias
keyPassword=your_key_password
